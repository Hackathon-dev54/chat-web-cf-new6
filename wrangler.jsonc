{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chat-web-cf-new6",
  "main": "src/server/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chatze_db","database_id": "bd4a8624-3d40-4d4a-bc0f-4252dcef3c0b"
    }
  ],
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  },
  "vars": {
    "NODE_ENV": "production"
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": false
  }
}
